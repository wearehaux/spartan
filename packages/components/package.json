{
  "name": "@spartan/components",
  "version": "0.1.0",
  "private": true,
  "description": "Lit Web Components for the Spartan Design System.",
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/components/**/define.ts",
    "./src/foundations/**/color-palette.ts",
    "./dist/index.js",
    "./dist/components/**/define.js",
    "./dist/tokens.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/button/define.d.ts",
      "default": "./dist/components/button/define.js"
    },
    "./button/class": {
      "types": "./dist/components/button/sp-button.d.ts",
      "default": "./dist/components/button/sp-button.js"
    },
    "./icon-button": {
      "types": "./dist/components/icon-button/define.d.ts",
      "default": "./dist/components/icon-button/define.js"
    },
    "./icon-button/class": {
      "types": "./dist/components/icon-button/sp-icon-button.d.ts",
      "default": "./dist/components/icon-button/sp-icon-button.js"
    },
    "./input": {
      "types": "./dist/components/input/define.d.ts",
      "default": "./dist/components/input/define.js"
    },
    "./input/class": {
      "types": "./dist/components/input/sp-input.d.ts",
      "default": "./dist/components/input/sp-input.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json",
    "./textarea": {
      "types": "./dist/components/textarea/define.d.ts",
      "default": "./dist/components/textarea/define.js"
    },
    "./textarea/class": {
      "types": "./dist/components/textarea/sp-textarea.d.ts",
      "default": "./dist/components/textarea/sp-textarea.js"
    },
    "./checkbox": {
      "types": "./dist/components/checkbox/define.d.ts",
      "default": "./dist/components/checkbox/define.js"
    },
    "./checkbox/class": {
      "types": "./dist/components/checkbox/sp-checkbox.d.ts",
      "default": "./dist/components/checkbox/sp-checkbox.js"
    },
    "./radio-group": {
      "types": "./dist/components/radio-group/define.d.ts",
      "default": "./dist/components/radio-group/define.js"
    },
    "./radio-group/class": {
      "types": "./dist/components/radio-group/sp-radio-group.d.ts",
      "default": "./dist/components/radio-group/sp-radio-group.js"
    },
    "./radio-group-item/class": {
      "types": "./dist/components/radio-group/sp-radio-group-item.d.ts",
      "default": "./dist/components/radio-group/sp-radio-group-item.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp ../../public/tokens.css dist/tokens.css && mkdir -p dist/components/checkbox/assets && cp src/components/checkbox/assets/*.svg dist/components/checkbox/assets/",
    "typecheck": "pnpm icons:generate && tsc --noEmit",
    "storybook": "pnpm icons:generate && storybook dev --port ${PORT:-6006} --host 127.0.0.1 --no-open",
    "build-storybook": "pnpm icons:generate && storybook build --output-dir storybook-static",
    "icons:generate": "node scripts/generate-story-icons.mjs",
    "test:stories": "pnpm icons:generate && vitest run --project storybook"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@storybook/addon-designs": "11.1.4",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/web-components-vite": "10.6.1",
    "@types/react": "^19.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "storybook": "10.6.1",
    "typescript": "~5.9.3",
    "vite": "8.2.2",
    "@storybook/addon-vitest": "10.6.1",
    "vitest": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "playwright": "1.62.1",
    "@vitest/coverage-v8": "5.0.3"
  },
  "optionalDependencies": {
    "@central-icons-react/round-outlined-radius-2-stroke-1.5": "1.2.8"
  }
}
